; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Backpack Battles"
run/main_scene="res://Core/Main.tscn"
config/features=PackedStringArray("4.7")
run/flush_stdout_on_print=true
run/low_processor_mode_sleep_usec=33000
boot_splash/image="res://Assets/Splashscreen.png"
config/icon="res://ClientIcon_256.png"

[audio]

default_bus_layout="res://Utility/default_bus_layout.tres"

[autoload]

ControllerIcons="*res://addons/controller_icons/ControllerIcons.gd"
Util="*res://Utility/Util.gd"
SteamHelper="*res://Utility/SteamHelper.gd"
Settings="*res://Utility/Settings.gd"
InputMapping="*res://Interface/Options/InputMapping.gd"
SilentWolf="*res://addons/silent_wolf/SilentWolf.gd"
ItemBook="*res://Sheets/ItemBook.gd"
SkinBook="*res://Utility/SkinBook.gd"
Game="*res://Core/Game.gd"
ObjectPool="*res://Utility/ObjectPool.gd"
RunDatabase="*res://Core/RunDatabase.gd"
Sound="*res://Utility/Sound.tscn"
CrazySDK="*res://Utility/CrazySDK.gd"
CraftingManager="*res://Core/CraftingManager.gd"
MaterialCompiler="*res://Utility/MaterialCompiler.gd"
EventBus="*res://Utility/EventBus.gd"
CustomRules="*res://Utility/CustomRules.gd"
InputBlocker="*res://Interface/InputBlocker.tscn"

[debug]

gdscript/warnings/unused_variable=false
gdscript/warnings/unused_signal=false
gdscript/warnings/integer_division=false
gdscript/warnings/narrowing_conversion=false
gdscript/warnings/deprecated_keyword=false
shapes/collision/shape_color=Color(0.701961, 0.541176, 0, 0.419608)
gdscript/warnings/unused_argument=false

[display]

window/stretch/mode="2d"
mouse_cursor/custom_image="res://Assets/Cursor/Cursor_default_small.png"
mouse_cursor/custom_image_hotspot=Vector2(20, 25)
window/size/width=1920
window/size/height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/controller_icons/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/silent_wolf/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/use_hidpi=true

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": true,
"flags/anisotropic": false,
"flags/filter": true,
"flags/mipmaps": true,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}
mp3={
"loop": false,
"loop_offset": 0
}
ogg_vorbis={
"loop": false,
"loop_offset": 0
}

