[sub_resource type="Shader" id=390]
code = "shader_type canvas_item;

uniform float revealState : hint_range(-1,1) = 0.5;

void fragment() {
	vec2 difToCenter = vec2(0.5,0.5) - UV;
	float relativeAngle = (-atan(-difToCenter.x, -difToCenter.y)) / 6.28 + 0.5;
	COLOR = texture(TEXTURE, UV);
	//COLOR.rgb *= 1.0 + 10.0 * (1.0- smoothstep(relativeAngle-0.1,relativeAngle+0.15, revealState));
	COLOR.a *= step(relativeAngle, revealState);
}"

